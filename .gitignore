# ─── Internal working material ────────────────────────────────────────────────
# Implementation plans, team review tracks, design docs, prototypes and scratch
# files. Local-only by decision: the public repo carries backend/, frontend/ and
# the README, nothing else.
internal/

# ─── Secrets ──────────────────────────────────────────────────────────────────
# The .env.example files ARE committed; the filled-in ones never are.
.env
.env.*
!.env.example
!.env.*.example

# ─── Python ───────────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# ─── Node / Next ──────────────────────────────────────────────────────────────
node_modules/
.next/
out/
*.tsbuildinfo
.vercel/

# ─── Runtime state ────────────────────────────────────────────────────────────
# Local object store: uploaded PDFs and page rasters. Regenerated by re-ingesting.
backend/storage/

# Generated LLM response cache. The committed entries under backend/ml/llm_cache
# are the demo fixtures (DEMO_MODE reads them); new ones written at runtime are not
# checked in unless deliberately added with `git add -f`.

# ─── ML artifacts ─────────────────────────────────────────────────────────────
# Trained models and the model card ARE committed — a deployed backend cannot
# train on boot, and the model card is the evidence behind every prediction.
# Only intermediate build output is ignored.
backend/ml/data/interim/
backend/ml/**/*.tmp

# ─── OS and editor noise ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
