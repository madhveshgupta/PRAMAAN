# PRAMAAN — copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://localhost:5432/pramaan
STORAGE_ROOT=./storage
JWT_SECRET=dev-only-change-me-32-bytes-minimum-secret
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
MAX_UPLOAD_MB=100

# Browser origins allowed to call this API, comma-separated. Only consulted on a split
# deploy — in dev the frontend proxies through Next and is same-origin.
#   deploy  https://sih-final-sigma.vercel.app
CORS_ORIGINS=http://localhost:3000

# Cloud LLM — Google Gemini. All calls go through api/app/llm/provider.py (invariant #5).
# GOOGLE_API_KEY is accepted as an alias, since that is the name Google's own SDK uses.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Gemini 3.x thinking. LOW for deterministic extraction; "" for a 2.5-family model, which
# rejects the parameter. Thinking tokens are billed and count against the output allowance.
LLM_THINKING_LEVEL=LOW
LLM_TIMEOUT_SECONDS=90

# Serve LLM responses from the committed cache only. Never touches the network.
DEMO_MODE=false

# Optional capabilities — the app degrades gracefully when these are absent.
# pgvector: enables the semantic fallback (F3) and duplicate detection (F10)
# tesseract: enables the OCR path for scanned pages (F1)
