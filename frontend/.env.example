# PRAMAAN web — copy to .env.local for local dev. Never commit .env.local.
#
# Where the FastAPI backend lives. Next proxies /api/v1/* here (see next.config.mjs),
# so the browser only ever talks to this origin and CORS never enters the picture.
#   local   http://localhost:8000
#   deploy  https://pramaan-api-v1ue.onrender.com   (no trailing slash)
API_PROXY_TARGET=http://localhost:8000
